rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the administrator
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.uid == 'admin-master-uid'
      );
    }

    // Wishes collection security rules
    match /wishes/{wishId} {
      // Any authenticated user (or Ananya) can read wishes
      allow read: if true;

      // Ananya or visitor can create a wish with valid initial fields
      allow create: if true;

      // Only authenticated administrator can update status, expected date, or admin response
      allow update: if isAdmin() || (
        // Allow user to edit their own wish content only if it has not been modified by admin yet
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'category', 'imageUrl'])
      );

      // Only administrator can delete wishes
      allow delete: if isAdmin();
    }

    // Messages collection security rules (Genie Notes)
    match /messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
